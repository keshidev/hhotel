APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
FRONTEND_URL=http://localhost:5173
AUTH_PASSWORD_RESET_EXPIRE=30
AUTH_PASSWORD_RESET_THROTTLE=60
# Comma-separated proxy IPs/CIDRs or '*' (only if your app is behind trusted proxies)
# TRUSTED_PROXIES=127.0.0.1,10.0.0.1
# TRUSTED_PROXIES=*
# TRUSTED_PROXIES_ALLOW_WILDCARD=false

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SANCTUM_EXPIRATION_MINUTES=480
CORS_ALLOWED_ORIGINS=http://localhost:5173
SECURITY_HEADERS_ENABLED=true
SECURITY_HSTS_MAX_AGE=31536000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

SCHEDULER_HEARTBEAT_NAME=default
SCHEDULER_HEARTBEAT_MAX_AGE_SECONDS=180
RELEASE_BACKUP_VERIFICATION_MAX_AGE_HOURS=24
RELEASE_BACKUP_ARTIFACT_MAX_AGE_HOURS=48
RELEASE_BACKUP_MINIMUM_BYTES=1024

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_TIMEOUT=15
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

BOOKING_PENDING_EXPIRY_MINUTES=30
BOOKING_WALK_IN_CHECK_IN_GRACE_MINUTES=15
BOOKING_STAY_EXTENSION_MAX_DAYS=30
BOOKING_MAX_PER_IP_PER_DAY=3
BOOKING_NO_SHOW_CUTOFF_TIME=18:00
BOOKING_GUEST_ACCESS_COOKIE_PREFIX=hotel_guest_booking_
BOOKING_GUEST_ACCESS_TTL_MINUTES=60
BOOKING_GUEST_ACCESS_MAX_ACTIVE_SESSIONS=5
BOOKING_CAPTCHA_ENABLED=false
BOOKING_CAPTCHA_PROVIDER=recaptcha
BOOKING_RECAPTCHA_SECRET=
BOOKING_RECAPTCHA_MIN_SCORE=0.5
BOOKING_RECAPTCHA_EXPECTED_ACTION=booking_submit
BOOKING_RECAPTCHA_EXPECTED_HOSTNAMES=localhost,hhotelbooking.com

PAYMENT_PROVIDER=disabled
MANUAL_GCASH_PAYMENT_WINDOW_MINUTES=30
MANUAL_GCASH_REVIEW_TARGET_MINUTES=15
MANUAL_GCASH_REVIEW_HOLD_MINUTES=120
MANUAL_GCASH_MAX_SUBMISSION_ATTEMPTS=3
MANUAL_GCASH_MAX_PROOF_KILOBYTES=5120
MANUAL_GCASH_PREPARE_ATTEMPTS_PER_MINUTE=10
MANUAL_GCASH_PREPARE_IP_ATTEMPTS_PER_MINUTE=60
MANUAL_GCASH_PROOF_REQUESTS_PER_MINUTE=10
MANUAL_GCASH_PROOF_IP_REQUESTS_PER_MINUTE=60
MANUAL_GCASH_RESUME_REQUESTS_PER_MINUTE=10
MANUAL_GCASH_RESUME_LINK_REQUESTS_PER_MINUTE=10
MANUAL_GCASH_RESUME_IP_REQUESTS_PER_MINUTE=60
MANUAL_GCASH_PROOF_RETENTION_DAYS=180
MANUAL_GCASH_RECONCILIATION_MAX_AGE_MINUTES=1440
MANUAL_GCASH_RECONCILIATION_DUE_SOON_MINUTES=240
MANUAL_GCASH_RECONCILIATION_EXCEPTION_MAX_AGE_MINUTES=1440
MANUAL_GCASH_REFUND_MAX_AGE_MINUTES=1440
MANUAL_GCASH_QUEUE_JOB_MAX_AGE_MINUTES=15
MANUAL_GCASH_LAUNCH_MERCHANT_VERIFIED=false
MANUAL_GCASH_LAUNCH_STAFF_TRAINED=false
MANUAL_GCASH_LAUNCH_BACKUP_CONFIRMED=false
MANUAL_GCASH_LAUNCH_ROLLBACK_REVIEWED=false
MANUAL_GCASH_PRODUCTION_LAUNCH_APPROVED=false
# Contact inquiry protection and retention
CONTACT_DUPLICATE_WINDOW_MINUTES=10
CONTACT_INQUIRY_RETENTION_DAYS=365
CONTACT_RATE_LIMIT_PER_MINUTE=5
CONTACT_RATE_LIMIT_PER_HOUR=10
CONTACT_CAPTCHA_ENABLED=false
CONTACT_CAPTCHA_PROVIDER=recaptcha_v3
CONTACT_CAPTCHA_SECRET=
CONTACT_CAPTCHA_MINIMUM_SCORE=0.5
CONTACT_CAPTCHA_EXPECTED_ACTION=contact_submit
CONTACT_CAPTCHA_EXPECTED_HOSTNAMES=
